VITE_PROJECT_NAME=VidGrid-HTML
VITE_PROJECT_URL=https://gitlab.com/aknott001/vidgrid-html
VITE_AUTHOR_URL=https://gitlab.com/aknott00
VITE_AUTHOR_NAME=aknott
VITE_DEBUG=false

# --- docker-compose.yml runtime config ---
# Everything below is read by `docker compose` at container start (not by
# Vite/the build), and every value already has a safe default in
# docker-compose.yml -- uncomment only what you need to override.
# WEB_PORT=8000
# SHARED_PATH=./shared
# VIDGRID_SHARED_DIR=/shared
# VIDGRID_IDLE_MINUTES=60
# VIDGRID_SWEEP_INTERVAL_MINUTES=10

# Traefik reverse-proxy labels -- no-op unless TRAEFIK_ENABLE=true.
# Requires an external "proxy" Docker network (see docker-compose.yml).
# TRAEFIK_ENABLE=true
# TRAEFIK_HOST=vidgrid.localhost
# TRAEFIK_ENTRYPOINTS=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
